{
  "name": "ubersuggest-seo-tools",
  "private": true,
  "version": "1.2.1",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "build": "vite build",
    "check": "pnpm typecheck && pnpm lint:format:sort && pnpm test",
    "dev": "vite build --watch",
    "env:clean": "wp-env clean all",
    "env:debug": "wp-env start --xdebug",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "format": "biome format",
    "format:fix": "biome format --write",
    "i18n:mo": "npx @wordpress/env run cli --env-cwd=wp-content/plugins/${PWD##*/} sh -c 'for po in languages/*.po; do wp i18n make-mo \"$po\" languages/; done'",
    "i18n:po": "npx @wordpress/env run cli --env-cwd=wp-content/plugins/${PWD##*/} sh -c 'for po in languages/*.po; do wp i18n update-po languages/ubersuggest-seo-tools.pot \"$po\"; done'",
    "i18n:pot": "npx @wordpress/env run cli --env-cwd=wp-content/plugins/${PWD##*/} wp i18n make-pot . languages/ubersuggest-seo-tools.pot --exclude=node_modules,vendor,tests,src,assets,build,dev --slug=ubersuggest-seo-tools",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "lint:format:sort": "biome check",
    "lint:format:sort:fix": "biome check --write",
    "release": "bash scripts/release.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:php": "npx @wordpress/env run cli --env-cwd=wp-content/plugins/${PWD##*/} vendor/bin/phpunit -c phpunit.xml.dist",
    "test:php:integration": "npx @wordpress/env run tests-cli --env-cwd=wp-content/plugins/${PWD##*/} vendor/bin/phpunit -c phpunit-integration.xml.dist",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ubersuggest/ui": "^1.84.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.80.0",
    "use-intl": "4.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "@wordpress/env": "^11.13.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.5",
    "typescript": "~5.8.3",
    "vite": "^7.0.5",
    "vitest": "^4.1.10"
  }
}
